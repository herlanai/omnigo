{
  "name": "omnigo-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test:web": "node --test omniweb/client/*.test.ts",
    "dev": "go run ./scripts/devtool dev",
    "dev:studio": "go run ./scripts/devtool dev",
    "build": "go run ./scripts/devtool build",
    "build:studio": "go run ./scripts/devtool build",
    "build:web": "pnpm --filter @omnigo/studio-ui build",
    "start": "go run ./scripts/devtool start",
    "package": "go run ./scripts/devtool package",
    "studio:catalog": "go run ./scripts/devtool catalog",
    "check:studio": "go test ./studio/... && pnpm --filter @omnigo/studio-ui typecheck",
    "setup:chromium": "go run ./scripts/devtool chromium",
    "dev:browser": "go run ./examples/chromium"
  },
  "packageManager": "pnpm@10.33.0"
}
