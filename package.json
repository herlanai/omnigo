{
  "name": "omnigo-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test:web": "node --test omniweb/client/*.test.ts",
    "dev": "go run ./tools/cmd/dev dev",
    "dev:studio": "go run ./tools/cmd/dev dev",
    "build": "go run ./tools/cmd/dev build",
    "build:studio": "go run ./tools/cmd/dev build",
    "build:web": "pnpm --filter @omnigo/studio-ui build",
    "start": "go run ./tools/cmd/dev start",
    "package": "go run ./tools/cmd/dev package",
    "studio:catalog": "go run ./tools/cmd/dev catalog",
    "check:studio": "go test ./examples/studio/... && pnpm --filter @omnigo/studio-ui typecheck",
    "setup:chromium": "go run ./tools/cmd/dev chromium",
    "dev:browser": "go run ./examples/chromium"
  },
  "packageManager": "pnpm@10.33.0"
}
